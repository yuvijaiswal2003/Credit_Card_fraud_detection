    "((150, 4), (150,))\n",
    ">>> clf = svm.SVC(kernel='linear', C=1, random_state=42)\n",
    ">>> scores = cross_val_score(clf, X, y, cv=5)\n",
    ">>> scores\n",
    "array([0.96..., 1. , 0.96..., 0.96..., 1. ])\n",
    "```\n",
    "\n"
   ]
